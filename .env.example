# Example shell environment. Copy to .env, edit, then: set -a; . ./.env; set +a
# No device is selected by default. Use the exact serial shown by adb devices -l.
HSR_UI_SERIAL=
HSR_UI_MODEL=9469X
HSR_UI_PRODUCT=Bellona_WF_GL
HSR_UI_GAME_PACKAGE=com.HoYoverse.hkrpgoversea
# Optional; leave unset for the standard local ADB server.
# ADB_SERVER_SOCKET=tcp:127.0.0.1:5037
# HSR_UI_PYTHON=/absolute/path/to/python
# HSR_UI_LAUNCHER=/absolute/path/to/hsr-ui/hsr-ui
# HSR_UI_ASSET_DIR=/absolute/path/to/private/assets
# HSR_UI_UNLOCK_HELPER=/absolute/path/to/local-unlock-helper
# HSR_UI_BRIGHTNESS_STATE=/absolute/path/to/private/brightness-state
# HSR_UI_SCRCPY_SERVER=/usr/share/scrcpy/scrcpy-server
# Optional GPU detection (requires compatible torch and onnxruntime-gpu).
HSR_UI_OCR_CUDA=0
